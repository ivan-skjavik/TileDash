# Environment variables for TileDash - EXAMPLE
# Copy this file to .env and fill in your actual values

# Add your Homey token here for automatic authentication
# This will be used before checking URL parameters
HOMEY_TOKEN=your_homey_token_here

# Database configuration
DB_PATH=./db/tiledash.db

# Server configuration
PORT=3001
VITE_PORT=3000

# Development settings
NODE_ENV=development
