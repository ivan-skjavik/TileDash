# Environment variables for TileDash - EXAMPLE
# Copy this file to .env and fill in your actual values

# Database configuration
DB_PATH=./db/tiledash.db

# Server configuration
PORT=3001
VITE_PORT=3000

# Development settings
NODE_ENV=development

# Homey OAuth Configuration
# Get these from your Homey Developer Account at https://developer.athom.com
# IMPORTANT: VITE_ prefix is required for frontend environment variables in Vite
VITE_HOMEY_CLIENT_ID=your_homey_client_id_here
VITE_HOMEY_CLIENT_SECRET=your_homey_client_secret_here
VITE_HOMEY_REDIRECT_URL=http://localhost:3000/auth/callback

# Streaming Configuration (for Live Camera Feed tiles)
FFMPEG_ENABLE_HARDWARE_ACCELERATION=true
FFMPEG_MAX_CONCURRENT_STREAMS=5
FFMPEG_BUFFER_SIZE=512
FFMPEG_LOW_LATENCY=true

# Performance Settings
UV_THREADPOOL_SIZE=32

# Stream Quality Defaults
DEFAULT_STREAM_QUALITY=medium
MAX_STREAM_BITRATE=3000
ENABLE_ADAPTIVE_QUALITY=true

# Debug Settings (set to 'tiledash:streaming' for streaming debug info)
# DEBUG=tiledash:streaming
